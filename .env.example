# Copy this file to .env and add private PayPal Sandbox and Gemini credentials.
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_SECRET=your_sandbox_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional email for scripts/test_invoice.py; use a Sandbox Personal account.
TEST_CLIENT_EMAIL=your-sandbox-personal-account@example.com
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Club fee display defaults. The UPI ID below is intentionally fake.
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL=₹
CLUB_UPI_ID=yourclub@upi
CLUB_NAME=Your Club
