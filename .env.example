# Copy this file to .env and add your PayPal Sandbox app credentials.
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_SECRET=your_sandbox_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: the email address of your PayPal Sandbox PERSONAL test account.
TEST_CLIENT_EMAIL=your-sandbox-personal-account@example.com

# Google Gemini API settings (get a key from Google AI Studio).
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Browser origins allowed to call the local API. On Render, use the frontend URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
